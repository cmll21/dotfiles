# Enable Vi mode
if status is-interactive
    # Enable Vim key bindings
    fish_vi_key_bindings

    # Configure cursor shapes for each mode
    set -g fish_cursor_default block # Normal mode
    set -g fish_cursor_insert line # Insert mode
    set -g fish_cursor_replace_one underscore # Replace mode (single char)
    set -g fish_cursor_replace underscore # Replace mode
    set -g fish_cursor_visual block # Visual mode
end

functions -e fish_mode_prompt

# Setup PATH
{{ if eq .chezmoi.os "darwin" -}}
set -x PATH /opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin $HOME/.local/bin
{{- else -}}
set -x PATH /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin /usr/local/bin /usr/bin /bin /usr/sbin /sbin $HOME/.local/bin
{{- end }}

# Setup Rust
set -x PATH $HOME/.cargo/bin $PATH

# Set default editor
set -x EDITOR nvim

# Set greeting
set fish_greeting # "Welcome back, $(whoami)! Today is $(date '+%A, %B %d, %Y')."

# C headers and libs (Homebrew only)
{{ if eq .chezmoi.os "darwin" -}}
set -x CPATH /opt/homebrew/include $CPATH
set -x LIBRARY_PATH /opt/homebrew/lib $LIBRARY_PATH
{{- else -}}
set -x CPATH /home/linuxbrew/.linuxbrew/include $CPATH
set -x LIBRARY_PATH /home/linuxbrew/.linuxbrew/lib $LIBRARY_PATH
{{- end }}

# NVM — Use Fish-native plugin instead of Bash scripts
# Install with: fisher install jorgebucaran/nvm.fish
set -x NVM_DIR $HOME/.nvm

# Zoxide directory jumper
if command -q zoxide
    zoxide init fish | source
end

# Theme
fish_config theme choose catppuccin-mocha

# Prompt
starship init fish | source

# Aliases
abbr -a c claude
abbr -a ta 'tmux attach -t'
abbr -a tad 'tmux attach -d -t'
abbr -a ts 'tmux new-session -s'
abbr -a tl 'tmux list-sessions'
abbr -a tksv 'tmux kill-server'
abbr -a tkss 'tmux kill-session -t'
if command -q eza
    alias ls='eza --icons --group-directories-first --color=always'
    alias ll='eza -lh --icons --group-directories-first --git'
    alias la='eza -lha --icons --group-directories-first --git'
    alias lt='eza --tree --level=2 --icons'
end
if command -q rg
    abbr -a grep rg
end
if not command -q fd; and command -q fdfind
    abbr -a fd fdfind
end
if command -q bat
    abbr -a cat bat
else if command -q batcat
    abbr -a cat batcat
end

# oh-my-zsh style navigation
abbr -a .. 'cd ..'
abbr -a ... 'cd ../..'
abbr -a .... 'cd ../../..'
abbr -a ..... 'cd ../../../..'
for i in (seq 1 9)
    abbr -a $i "prevd $i"
end
